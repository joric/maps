{
  "name": "Order of the Sinking Star",
  "size": 190,
  "worlds": {
    "overworld": {
      "heightRange": [-4,10],
      "layers": [
        {
          "bounds": { "left": -77, "top": 221.5, "right": 219, "bottom": 74},
          "name": "Release_v1",
          "urlTemplate": "tiles/Release_v1/{z}/{y}/{x}.webp",
          "tileSize": 512,
          "maxAvailableZoom": 5,
          "repeatWorld": false,
          "size": [12450, 10956],
          "comment": "by qiekn, see #9"
        },
        {
          "bounds": { "left": -6, "top": 185, "right": 186, "bottom": -7},
          "name": "Demo2_16k",
          "urlTemplate": "tiles/Demo2_16k/{z}/{y}/{x}.webp",
          "tileSize": 512,
          "maxAvailableZoom": 5,
          "size": [16384, 9216],
          "comment": "scaled 1920x1080 screenshot, 192x108 grid with center at cell 86,74 (real world center is 80,69 in game units)"
        },
        {
          "name": "overworld_2160p",
          "bounds": {"left": -65, "top": 157, "right": 223, "bottom": -5},
          "url": "images/overworld_2160p.jpg",
          "overlay": true,
          "size": [3840, 2160],
          "remap": { "cellSize": 13.34, "dx": -65, "dy": -5 },
          "comment": "from YouTube trailer, https://youtu.be/4m8R1BjjioU?t=90"
        }
      ],
      "grid": [
        {
          "name": "default_grid",
          "bounds": { "left": 81.5, "top": -15.5, "right":241.5, "bottom": 166.5},
          "center": { "left": 89.5, "top": 75.5 }
        }
      ],
      "markers": {
        "url": "scripts/markers.geojson"
      },
      "regions1": [
        {
          "name": "default",
          "image": "scripts/regions.png",
          "url": "scripts/regions.json",
          "size": 192,
          "simplify": "100%",
          "dx": -5.5,
          "dy": -7.5,
          "flip_y": true,
          "colors": {
            "#000000": "center",
            "#ffff00": "crossroads",
            "#0000ff": "promesst",
            "#ffa500": "mirror",
            "#ff0000": "heroes1",
            "#00ff00": "heroes2",
            "#ff00ff": "heroes3",
            "#00ffff": "water"
          }
        }
      ]
    },
    "underworld": {
      "heightRange": [-57,-4]
    },
    "sky": {
      "heightRange": [10, 75]
    }
  },

  "templates" : {
    "popup": {
      "image": "data/images/levels/{name}.webp",
      "wiki": ""
    }
  },

  "localization": {
    "path": "data/Localization/",
    "files": {
      "de": "de.json",
      "en": "en.json",
      "es": "es.json",
      "fr": "fr.json",
      "it": "it.json",
      "ja": "ja.json",
      "ko": "ko.json",
      "pt-br": "pt-br.json",
      "ru": "ru.json",
      "s-cn": "s-cn.json",
      "t-cn": "t-cn.json"
    }
  },


  "groups": {
    "items": { "default": true },
    "levels": { "default": true },
    "markers": { },
    "misc": { }
  },

  "icons": {
    "audiolog": { "class": "fa fa-volume", "color": "chocolate" },
    "dragon": { "class": "fa fa-dragon", "color": "indianred" },
    "freezer": { "class": "fa fa-snowflake", "color": "slategrey" },
    "gate": { "class": "fa fa-door-closed", "color": "slategrey" },
    "gem": { "class": "fa fa-gem", "color": "cornflowerblue" },
    "gem_slot": { "class": "fa-regular fa-gem", "color": "slategrey" },
    "map": { "class": "fa fa-compass", "color": "skyblue" },
    "level": { "class": "fa fa-bahai", "color": "orange" },
    "mirror": { "class": "fa fa-clone", "color": "cornflowerblue" },
    "monster": { "class": "fa fa-skull", "color": "palevioletred" },
    "marker": { "class": "fa fa-location-crosshairs", "color": "grey" },
    "local_area": { "class": "fa fa-cube", "color": "grey" },
    "reset": { "class": "fa fa-rotate", "color": "slategrey" },
    "switch": { "class": "fa fa-toggle-off", "color": "slategrey" },
    "rock": { "class": "fa fa-cube", "color": "grey" },
    "sign": { "class": "fa fa-receipt", "color": "brown" },
    "spawner": { "class": "fa fa-gift", "color": "darkcyan" },
    "teleport": { "class": "fa fa-street-view", "color": "slategrey" }
  },

  "types": {
    "group": "misc",
    "match": {
      "type": {
        "regionMarker": { "group": "regions" },
        "Area_Pin": { "group": "items", "category": "map", "icon": "map"},
        "Activator": { "group": "items", "category": "reset", "icon": "reset" },
        "Freezer": { "group": "items", "category": "freezer", "icon": "freezer" },
        "Gate": { "group": "items", "category": "gate", "icon": "gate" },
        "Gem": { "group": "items", "category": "gem", "icon": "gem" },
        "Gem_Slot": { "group": "items", "category": "gem_slot", "icon": "gem_slot" },
        "Level_Entry": { 
          "group": "levels", "icon": "level",
          "match": {
            "area": {
              ".*": {}
            }
          }
        },


        "Marker": {
          "group": "markers", "category": "marker", "icon": "marker",
          "match": {
            "entity_properties.script_name": {
              "local_area": { "group": "markers", "category": "local_area", "icon": "local_area" }
            }
          }
        },


        "Mirror":  { "group": "items", "category": "Mirror", "icon": "mirror" },
        "Monster":  { "group": "items", "category": "monster", "icon": "monster", "match": {
          "name": {
            "soko1_dragon": { "icon": "dragon" }
            }
          }
        },
        "Rock": { "group": "misc", "category": "rock", "icon": "rock" },
        "Voice_Log": { "group": "items", "category": "audiolog", "icon": "audiolog" },
        "Sign": { "group": "items", "category": "sign", "icon": "sign" },
        "Spawner": { "group": "misc", "category": "spawner", "icon": "spawner" },
        "Switch": { "group": "items", "category": "switch", "icon": "switch" },
        "Teleporter": { "group": "items", "category": "teleport", "icon": "teleport" },

        ".*": { "group": "misc", "icon": "misc", "comment": "this rule maps type to category" }
      }
    }
  }
}
